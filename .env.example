# ─────────────────────────────────────────────────────────────────────────────
# HoneyChain — Environment Variable Reference
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Blockchain ────────────────────────────────────────────────────────────────

# Polygon Amoy testnet RPC URL
# Get a free endpoint from: https://rpc-amoy.polygon.technology/
# or Alchemy/Infura Amoy endpoint
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Deployer wallet private key (NO leading 0x, or WITH 0x — both work in ethers v6)
# ⚠️  NEVER commit a real private key. Use a dedicated testnet wallet.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract address (set after running scripts/deploy.js)
CONTRACT_ADDRESS=

# Chain IDs
# Local Hardhat: 31337
# Polygon Amoy: 80002
CHAIN_ID=80002

# ── Role Seeding (comma-separated Ethereum addresses, optional) ───────────────

# Addresses to receive BEEKEEPER_ROLE on deployment
INITIAL_BEEKEEPERS=

# Addresses to receive PROCESSOR_ROLE on deployment
INITIAL_PROCESSORS=

# Addresses to receive DISTRIBUTOR_ROLE on deployment
INITIAL_DISTRIBUTORS=

# Addresses to receive RETAILER_ROLE on deployment
INITIAL_RETAILERS=

# ── Backend Service ───────────────────────────────────────────────────────────

# Port for the Express API server (default: 3000)
PORT=3000

# SQLite database file path (use :memory: for ephemeral in-memory DB)
SQLITE_DB_PATH=./honeychain.db

# Backend operator wallet — signs transactions on behalf of the supply chain
# In production, use a hardware wallet or KMS. For local dev, use any Hardhat account.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC URL for the backend to connect to (can differ from AMOY_RPC_URL)
RPC_URL=http://127.0.0.1:8545
