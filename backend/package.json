{
  "name": "honeychain-backend",
  "version": "1.0.0",
  "description": "HoneyChain backend API service — blockchain + off-chain metadata",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "keywords": [],
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "globalSetup": "./test/globalSetup.js",
    "globalTeardown": "./test/globalTeardown.js",
    "testTimeout": 60000,
    "forceExit": true,
    "detectOpenHandles": false
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
